set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM240T100I5
set_global_assignment -name TOP_LEVEL_ENTITY osc
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "12:59:14  MAY 07, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR "-1"
set_global_assignment -name POWER_EXT_SUPPLY_VOLTAGE_TO_REGULATOR 3.3V
set_global_assignment -name EDA_DESIGN_ENTRY_SYNTHESIS_TOOL "Design Compiler"
set_global_assignment -name EDA_INPUT_VCC_NAME VDD -section_id eda_design_synthesis
set_global_assignment -name EDA_LMF_FILE altsyn.lmf -section_id eda_design_synthesis
set_global_assignment -name EDA_INPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_design_synthesis
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name VERILOG_FILE osc.v
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_location_assignment PIN_4 -to X2in
set_location_assignment PIN_3 -to X1out
set_location_assignment PIN_2 -to X1in
set_location_assignment PIN_5 -to X2out
set_location_assignment PIN_64 -to clk50
set_location_assignment PIN_74 -to clk50_out
set_location_assignment PIN_14 -to clkX
set_location_assignment PIN_75 -to clkX_out
set_instance_assignment -name CURRENT_STRENGTH_NEW "MINIMUM CURRENT" -to X1in
set_instance_assignment -name CURRENT_STRENGTH_NEW "MINIMUM CURRENT" -to X1out
set_instance_assignment -name CURRENT_STRENGTH_NEW "MINIMUM CURRENT" -to X2in
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to clk50
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to clk50_out
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to clkX
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to clkX_out
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to X2out
set_instance_assignment -name IO_STANDARD "3.3V SCHMITT TRIGGER INPUT" -to X1in
set_instance_assignment -name IO_STANDARD "3.3V SCHMITT TRIGGER INPUT" -to X2in
set_instance_assignment -name IO_STANDARD "3.3V SCHMITT TRIGGER INPUT" -to clkX